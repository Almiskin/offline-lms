PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=learning_platform
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=24h
MAX_FILE_SIZE_MB=50
APP_URL=http://localhost:3000

# Optional: real SMTP for password-reset emails. If SMTP_HOST is left blank,
# the server automatically uses a free Ethereal test inbox instead and logs
# a preview link to the console — no setup needed for local development/demo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
